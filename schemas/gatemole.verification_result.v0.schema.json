{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/gatemole/schemas/gatemole.verification_result.v0.schema.json",
  "title": "Gatemole VerificationResult v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "transaction_id", "name", "kind", "status",
    "effect_set_digest", "staged_state_digest", "verifier", "independence",
    "verifier_digest", "inputs_digest", "evidence", "summary", "evaluated_at"
  ],
  "properties": {
    "version": { "const": "gatemole.verification_result.v0" },
    "id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "transaction_id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "attempt": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "kind": { "type": "string", "enum": ["precondition", "invariant", "postcondition"] },
    "status": { "type": "string", "enum": ["passed", "failed", "indeterminate"] },
    "effect_set_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "staged_state_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "verifier": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/principal" },
    "independence": {
      "type": "string",
      "enum": ["agent_supplied", "platform_run", "external_attestation"]
    },
    "verifier_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "inputs_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/artifact_ref" }
    },
    "summary": { "type": "string", "minLength": 1 },
    "evaluated_at": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/timestamp" }
  }
}
