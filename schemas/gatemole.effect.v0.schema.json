{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/gatemole/schemas/gatemole.effect.v0.schema.json",
  "title": "Gatemole Effect v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "transaction_id", "sequence", "system", "resource",
    "operation", "arguments", "arguments_digest", "dependencies",
    "estimated_scope", "recovery_class", "status", "created_at", "updated_at"
  ],
  "properties": {
    "version": { "const": "gatemole.effect.v0" },
    "id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "transaction_id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "attempt": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "run_id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "origin_execution_id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "origin_action_id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "system": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "resource": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/resource_selector" },
    "operation": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "arguments": { "type": "object" },
    "arguments_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "estimated_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "objects": { "type": "integer", "minimum": 0 }
      }
    },
    "data_classification": { "type": "string", "minLength": 1 },
    "recovery_class": {
      "type": "string",
      "enum": ["read_only", "stageable", "reversible", "compensatable", "irreversible"]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed", "staged", "validated", "release_ready", "committing",
        "committed", "blocked", "rejected", "failed", "unknown",
        "compensating", "compensated", "manual_recovery_required"
      ]
    },
    "idempotency_key": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "stage_ref": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/artifact_ref" },
    "before_state_ref": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/artifact_ref" },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "arguments", "arguments_digest"],
      "properties": {
        "operation": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
        "arguments": { "type": "object" },
        "arguments_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
        "plan_ref": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/artifact_ref" }
      }
    },
    "receipt": { "$ref": "#/$defs/receipt" },
    "compensation_receipt": { "$ref": "#/$defs/receipt" },
    "created_at": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "operation_id", "result_digest", "committed_at"],
      "properties": {
        "driver": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
        "operation_id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
        "result_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
        "resource_version": { "type": "string", "minLength": 1 },
        "committed_at": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/timestamp" }
      }
    }
  }
}
