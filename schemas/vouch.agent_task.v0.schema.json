{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/vouch/schemas/vouch.agent_task.v0.schema.json",
  "title": "Vouch AgentTask v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "transaction_id",
    "namespace",
    "run_id",
    "intent",
    "intent_digest",
    "agent_profile",
    "created_at",
    "digest"
  ],
  "properties": {
    "version": { "const": "vouch.agent_task.v0" },
    "id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "transaction_id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "namespace": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "intent": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "intent_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "agent_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "runtime_class", "command_digest"],
      "properties": {
        "id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
        "digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
        "runtime_class": { "type": "string", "enum": ["oci", "host"] },
        "image_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "command_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "runtime_class": { "const": "oci" } },
            "required": ["runtime_class"]
          },
          "then": { "required": ["image_digest"] },
          "else": {
            "allOf": [
              { "not": { "required": ["image_digest"] } },
              { "not": { "required": ["entrypoint"] } }
            ]
          }
        }
      ]
    },
    "created_at": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/timestamp" },
    "digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" }
  }
}
