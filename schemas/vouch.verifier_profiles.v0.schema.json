{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/vouch/schemas/vouch.verifier_profiles.v0.schema.json",
  "title": "Vouch verifier profiles v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "version": { "const": "vouch.verifier_profiles.v0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image", "command", "timeout_seconds"],
        "properties": {
          "name": {
            "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier"
          },
          "image": {
            "type": "string",
            "pattern": "^([^\\s@]+@)?sha256:[a-f0-9]{64}$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    }
  }
}
