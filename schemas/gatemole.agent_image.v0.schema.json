{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/gatemole/schemas/gatemole.agent_image.v0.schema.json",
  "title": "Gatemole AgentImage v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "digest", "runtime", "source_digest", "publisher"],
  "properties": {
    "version": { "const": "gatemole.agent_image.v0" },
    "id": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
    "digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "entrypoint"],
      "properties": {
        "adapter": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "name"],
        "properties": {
          "provider": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "instructions": {
      "type": "array",
      "items": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/artifact_ref" }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "driver", "operations"],
        "properties": {
          "name": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
          "driver": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" }
          }
        }
      }
    },
    "contract_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "source_digest": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/digest" },
    "publisher": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/principal" },
    "signature": { "$ref": "gatemole.kernel.common.v0.schema.json#/$defs/artifact_ref" }
  }
}
