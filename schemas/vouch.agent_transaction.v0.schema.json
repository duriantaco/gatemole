{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/vouch/schemas/vouch.agent_transaction.v0.schema.json",
  "title": "Vouch AgentTransaction v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "namespace", "intent_digest", "sponsor",
    "agent_run_ids", "stage_bindings", "state", "effect_ids", "verification_result_ids",
    "outstanding_approval_ids", "event_sequence", "created_at", "updated_at"
  ],
  "properties": {
    "version": { "const": "vouch.agent_transaction.v0" },
    "id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "namespace": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "intent_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "task": { "$ref": "vouch.agent_task.v0.schema.json" },
    "sponsor": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/principal" },
    "agent_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "stage_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "resource", "location", "base_revision", "created_at"],
        "properties": {
          "id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
          "kind": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
          "resource": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/resource_selector" },
          "location": { "type": "string", "minLength": 1 },
          "base_revision": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/timestamp" }
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "created", "running", "staged", "validating", "validation_failed",
        "revise_required", "blocked", "pending_approval", "ready_to_commit",
        "committing", "committed", "compensating", "rolled_back", "release_failed",
        "partially_committed", "manual_recovery_required", "aborted"
      ]
    },
    "state_reason": { "type": "string", "minLength": 1 },
    "effect_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "verification_result_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "outstanding_approval_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "staged_state_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "effect_set_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "approval_package_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "commit_plan_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "event_sequence": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/timestamp" },
    "completed_at": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/timestamp" }
  }
}
