{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/vouch/schemas/vouch.agent_profiles.v0.schema.json",
  "title": "Vouch Agent Profiles v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "version": { "const": "vouch.agent_profiles.v0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "oci_image", "descriptor"],
        "properties": {
          "name": {
            "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier"
          },
          "oci_image": {
            "type": "string",
            "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
          },
          "descriptor": {
            "allOf": [
              {
                "$ref": "vouch.agent_image.v0.schema.json"
              },
              {
                "properties": {
                  "runtime": {
                    "properties": {
                      "adapter": { "const": "oci" }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
