{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duriantaco.github.io/vouch/schemas/vouch.policy_decision.v0.schema.json",
  "title": "Vouch PolicyDecision v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "run_id", "subject_type", "subject_id", "decision",
    "policy_digest", "facts_digest", "rules_fired", "reasons", "evaluated_at"
  ],
  "properties": {
    "version": { "const": "vouch.policy_decision.v0" },
    "id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "subject_type": {
      "type": "string",
      "enum": ["run", "action", "delegation", "checkpoint", "release"]
    },
    "subject_id": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "require_approval", "constrain", "pause", "terminate"]
    },
    "policy_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "facts_digest": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/digest" },
    "rules_fired": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/identifier" }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "evaluated_at": { "$ref": "vouch.kernel.common.v0.schema.json#/$defs/timestamp" }
  }
}
